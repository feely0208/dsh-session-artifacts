{
  "name": "@deepwhale-cn/dsh-session-artifacts",
  "version": "0.1.0",
  "description": "会话产物归拢与命名：每个会话一个专属文件夹，收尾按实际内容改名并刷新索引 —— 解决「产物散落满目录」和「过段时间记不清是什么」。附三个不依赖 DSH 的纯 bash 脚本。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh插件",
    "deepseek-harness",
    "plugin",
    "skill",
    "session",
    "session-artifacts",
    "artifact-management",
    "workspace-hygiene",
    "claude-code",
    "codex",
    "cursor",
    "agent",
    "workflow",
    "compliance",
    "audit-trail",
    "chinese"
  ],
  "files": [
    "lib",
    "skill",
    "bin",
    "cordis.patch.yml",
    "README.md"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "sess": "./bin/sess.sh",
    "sess-rename": "./bin/sess-rename.sh",
    "sess-index": "./bin/sess-index.sh"
  },
  "engines": {
    "dsh": ">=0.1.0-rc.6"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feely0208/dsh-session-artifacts.git"
  },
  "homepage": "https://github.com/feely0208/dsh-session-artifacts#readme",
  "bugs": {
    "url": "https://github.com/feely0208/dsh-session-artifacts/issues"
  }
}
